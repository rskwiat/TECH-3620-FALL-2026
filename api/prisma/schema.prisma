generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  home_address String?
  age          Int?
  createdAt    DateTime    @default(now())
  lastUpdated  DateTime    @updatedAt
  lastLogin    DateTime?
  habits       Habit[]
  loginCodes   LoginCode[]
}

// A one-time login code (passwordless auth). Only the SHA-256 hash of the
// 6-digit code is stored, never the plain code. A user has at most one active
// code at a time — requesting a new code deletes the previous rows.
model LoginCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  // Failed verify attempts against this code; the code dies at MAX_ATTEMPTS.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Habit {
  id             Int        @id @default(autoincrement())
  userId         Int
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String?
  emoji          String?
  // "DAILY" | "WEEKLY" — Prisma enums are unsupported on SQLite, so this is a
  // validated string; see routes/habits.ts for the allowed values.
  frequency      String     @default("DAILY")
  // How many times the habit should be completed per frequency period
  // (e.g. 3 times per day, or 2 times per week).
  timesPerPeriod Int        @default(1)
  archived       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  lastUpdated    DateTime   @updatedAt
  logs           HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          Int       @id @default(autoincrement())
  habitId     Int
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())
  note        String?
  createdAt   DateTime  @default(now())

  @@index([habitId, completedAt])
}
